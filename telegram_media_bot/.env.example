# ---------------------------------------------------------------------------
# telegram_media_bot ortam değişkenleri örneği
# Bu dosyayı ".env" olarak kopyalayıp kendi değerlerinizi girin.
# ---------------------------------------------------------------------------

# BotFather'dan aldığınız bot tokeni (zorunlu).
BOT_TOKEN=123456789:AAExampleTokenReplaceWithYourOwn

# Botu kullanmasına izin verilen Telegram user_id'leri, virgülle ayrılmış.
# Kendi user_id'nizi öğrenmek için Telegram'da @userinfobot ile konuşun.
WHITELISTED_USER_IDS=111111111,222222222

# Kullanıcı başına günlük üretim limitleri.
DAILY_IMAGE_QUOTA=20
DAILY_VIDEO_QUOTA=5
DAILY_STICKER_QUOTA=15

# --- OpenAI DALL-E 3 (görsel üretimi) --------------------------------------
# TODO: platform.openai.com üzerinden alınan gerçek API key'i buraya girin.
OPENAI_API_KEY=
# Hesabınızda "dall-e-3" yoksa (bazı yeni/proje bazlı API key'lerde artık
# sunulmuyor), OPENAI_IMAGE_MODEL değerini "gpt-image-1" olarak değiştirin.
# Kod her iki model ailesini de otomatik olarak destekler.
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024

# --- Video / animasyon sağlayıcısı -----------------------------------------
# "luma" veya "runway" seçilebilir.
VIDEO_PROVIDER=luma

# TODO: Luma Dream Machine API key'i (https://lumalabs.ai/dream-machine/api)
LUMA_API_KEY=
LUMA_API_BASE_URL=https://api.lumalabs.ai/dream-machine/v1

# TODO: Runway Gen-3 Alpha API key'i (https://dev.runwayml.com/)
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.runwayml.com/v1

# --- Yerel dosya/veritabanı yolları -----------------------------------------
DATABASE_PATH=data/bot.db
MEDIA_TMP_DIR=data/tmp

# Sisteminizde ffmpeg farklı bir isimle/yoldaysa burada belirtin.
FFMPEG_BINARY=ffmpeg

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Dış servis çağrıları için saniye cinsinden zaman aşımı.
REQUEST_TIMEOUT_SECONDS=60
